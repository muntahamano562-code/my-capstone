## Example .env for local development.
## Copy to .env and replace the placeholder with your own key. Do NOT commit real keys.
## Without GOOGLE_GENERATIVE_AI_API_KEY the app uses the mock provider fallback.
GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GOOGLE_GENERATIVE_AI_API_KEY
## Optional: override the Gemini model (defaults to gemini-3.5-flash).
GOOGLE_MODEL=gemini-3.5-flash